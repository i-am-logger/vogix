{
  "background": {
    "animate": "on-ac",
    "enable": true,
    "scanlines": false
  },
  "bar": {
    "enable": true,
    "height": 96,
    "layout": {
      "center": [],
      "left": [
        "workspaces",
        "mode"
      ],
      "right": [
        "kbd",
        "privacy",
        "dnd",
        "indicators",
        "theme",
        "clock"
      ]
    },
    "position": "top"
  },
  "bars": {
    "bottom": {
      "enable": true,
      "layout": {
        "center": [
          "oscilloscope"
        ],
        "end": [
          "uptime",
          "weather",
          "update",
          "tray",
          "spectrum-right"
        ],
        "start": [
          "spectrum-left"
        ]
      },
      "size": 96
    },
    "left": {
      "enable": true,
      "layout": {
        "center": [
          "vu-rail",
          "audio-out-picker",
          "spacer",
          "spacer",
          "spacer",
          "mic-rail",
          "audio-in-picker"
        ],
        "end": [
          "menu",
          "power-glyph"
        ],
        "start": [
          "mode"
        ]
      },
      "size": 128
    },
    "right": {
      "enable": true,
      "layout": {
        "center": [],
        "end": [
          "batteries",
          "battery",
          "audio",
          "network",
          "bluetooth"
        ],
        "start": [
          "stat-cpu",
          "stat-gpu",
          "stat-temp",
          "stat-mem",
          "stat-mounts",
          "graph-disk",
          "graph-net"
        ]
      },
      "size": 114
    },
    "top": {
      "enable": true,
      "layout": {
        "center": [],
        "end": [
          "kbd",
          "privacy",
          "dnd",
          "indicators",
          "theme",
          "clock"
        ],
        "start": [
          "workspaces",
          "mode"
        ]
      },
      "size": 96
    }
  },
  "decorations": {
    "focusBrackets": true
  },
  "font": {
    "family": "Fira Code Nerd Font",
    "size": 21
  },
  "idle": {
    "dim": 300,
    "lock": 600,
    "screenOff": 660,
    "screensaver": null,
    "suspend": null
  },
  "launcher": {
    "enable": true,
    "menu": [
      {
        "action": "vogix input keys",
        "icon": "󰌌",
        "id": "keybindings",
        "label": "Keybindings",
        "submenu": [],
        "when": null
      },
      {
        "action": "vogix desktop remind add 'Reminder' 10m",
        "icon": "󰀠",
        "id": "remind",
        "label": "Remind me in 10m…",
        "submenu": [],
        "when": null
      },
      {
        "action": "vogix desktop launcher --mode theme",
        "icon": "󰏘",
        "id": "theme",
        "label": "Theme…",
        "submenu": [],
        "when": null
      },
      {
        "action": "vogix desktop background next",
        "icon": "󰸉",
        "id": "background",
        "label": "Next background",
        "submenu": [],
        "when": null
      },
      {
        "action": "vogix desktop notify dnd toggle",
        "icon": "󰂛",
        "id": "dnd",
        "label": "Do not disturb",
        "submenu": [],
        "when": null
      },
      {
        "action": "vogix desktop panel agents",
        "icon": "󱚝",
        "id": "agents",
        "label": "Claude usage…",
        "submenu": [],
        "when": null
      },
      {
        "action": "vogix desktop lock",
        "icon": "󰌾",
        "id": "lock",
        "label": "Lock",
        "submenu": [],
        "when": null
      },
      {
        "action": "vogix desktop power",
        "icon": "󰐥",
        "id": "power",
        "label": "Power…",
        "submenu": [],
        "when": null
      }
    ],
    "modes": {
      "apps": {
        "enable": true
      },
      "background": {
        "enable": true
      },
      "calc": {
        "enable": true
      },
      "clipboard": {
        "enable": true
      },
      "emoji": {
        "enable": true
      },
      "files": {
        "enable": true
      },
      "ssh": {
        "enable": true
      },
      "theme": {
        "enable": true
      }
    }
  },
  "lock": {
    "enable": true,
    "pamService": "vogix-lock"
  },
  "meters": {
    "history": 64,
    "mounts": [
      "/nix",
      "/persist",
      "/boot",
      "swap",
      "/tmp"
    ],
    "sampleMs": 100,
    "spectrum": {
      "bars": 48,
      "enable": true
    },
    "thresholds": {
      "cpu": {
        "danger": 90,
        "warn": 50
      },
      "cpuTemp": {
        "danger": 85,
        "warn": 60
      },
      "memory": {
        "danger": 90,
        "warn": 60
      },
      "swap": {
        "danger": 80,
        "warn": 20
      }
    },
    "vu": {
      "floorDb": -40
    }
  },
  "nightlight": {
    "temperature": 4000
  },
  "notifications": {
    "appRules": {
      "yubikey-touch-detector": {
        "accent": "danger",
        "bypassDnd": true,
        "timeout": 15000
      }
    },
    "defaultTimeout": 5000,
    "enable": true,
    "maxVisible": 5
  },
  "osd": {
    "enable": true,
    "timeout": 1500
  },
  "polkit": {
    "enable": true
  },
  "power": {
    "enable": true
  },
  "schema": 2,
  "surfaces": {
    "bar": {
      "accent": {
        "alpha": 1.0,
        "slot": "active"
      },
      "background": {
        "alpha": 0.92,
        "slot": "background"
      },
      "border": {
        "alpha": 1.0,
