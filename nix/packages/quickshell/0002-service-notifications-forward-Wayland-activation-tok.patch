diff --git a/src/services/notifications/test/action.cpp b/src/services/notifications/test/action.cpp
new file mode 100644
index 0000000..017f6a4
--- /dev/null
+++ b/src/services/notifications/test/action.cpp
@@ -0,0 +1,85 @@
+#include <qobject.h>
+#include <qstringlist.h>
+#include <qtest.h>
+#include <qtestcase.h>
+#include <qtmetamacros.h>
+
+#include "../notification.hpp"
+#include "../server.hpp"
+
+using qs::service::notifications::Notification;
+using qs::service::notifications::NotificationAction;
+using qs::service::notifications::NotificationServer;
+
+class TestNotificationAction: public QObject {
+	Q_OBJECT;
+
+private slots:
+	// The spec allows an ActivationToken signal before ActionInvoked, carrying a token the
+	// client can use to activate a toplevel. When the server has one, it must arrive first.
+	static void tokenIsSentBeforeTheAction() {
+		auto seen = record();
+		auto* notification = new Notification(5, nullptr);
+		auto* action = new NotificationAction("default", "Open", notification);
+		notification->bindableResident().setValue(true);
+
+		action->invokeWithToken("token-1");
+
+		QCOMPARE(*seen, QStringList({"ActivationToken 5 token-1", "ActionInvoked 5 default"}));
+		delete notification;
+	}
+
+	// Without a token (no input to request one for), only ActionInvoked is sent.
+	static void withoutATokenOnlyTheActionIsSent() {
+		auto seen = record();
+		auto* notification = new Notification(6, nullptr);
+		auto* action = new NotificationAction("later", "Later", notification);
+		notification->bindableResident().setValue(true);
+
+		action->invokeWithToken(QString());
+
+		QCOMPARE(*seen, QStringList({"ActionInvoked 6 later"}));
+		delete notification;
+	}
+
+	// invoke() off Wayland has no token to request and invokes at once.
+	static void invokeOffWaylandInvokesAtOnce() {
+		auto seen = record();
+		auto* notification = new Notification(7, nullptr);
+		auto* action = new NotificationAction("default", "Open", notification);
+		notification->bindableResident().setValue(true);
+
+		action->invoke();
+
+		QCOMPARE(*seen, QStringList({"ActionInvoked 7 default"}));
+		delete notification;
+	}
+
+private:
+	static std::shared_ptr<QStringList> record() {
+		auto list = std::make_shared<QStringList>();
+		auto* server = NotificationServer::instance();
+		auto* receiver = new QObject(server);
+		QObject::connect(
+		    server,
+		    &NotificationServer::ActivationToken,
+		    receiver,
+		    [list](quint32 id, const QString& token) {
+			    list->append(QString("ActivationToken %1 %2").arg(id).arg(token));
+		    }
+		);
+		QObject::connect(
+		    server,
+		    &NotificationServer::ActionInvoked,
+		    receiver,
+		    [list](quint32 id, const QString& action) {
+			    list->append(QString("ActionInvoked %1 %2").arg(id).arg(action));
+		    }
+		);
+		QObject::connect(server, &QObject::destroyed, receiver, [receiver] { delete receiver; });
+		return list;
+	}
+};
+
+QTEST_MAIN(TestNotificationAction);
+#include "action.moc"
